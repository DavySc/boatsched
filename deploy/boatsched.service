[Unit]
Description=boatsched (FastAPI/uvicorn + OR-Tools CP-SAT + Yjs collab)
# Wait for a routable network before binding.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/boatsched

# --- IN-PROCESS STATE → SINGLE PROCESS ONLY ---------------------------------
# The web layer MUST run as exactly one process. Server-side state lives in this
# process's memory and cannot be shared across workers:
#   - JOBS            (server.py:29)        solve-job results
#   - sessions        (server.py:255)       auth sessions
#   - docs / rooms    (server.py:250-251)   per-schedule pycrdt.Doc + the live
#                                           WebSocket objects used for collab
#                                           broadcast (_broadcast, server.py:745)
# A second worker would hold a DISJOINT set of WebSockets/docs/sessions, so Yjs
# edits would not propagate between editors and logins would randomly 401.
# `boatsched-server` calls uvicorn.run(app, ...) with no workers= arg, i.e. a
# single process — do NOT wrap this in gunicorn -w N or pass extra workers.
#
# NOTE: --workers below is the *solver's* CP-SAT search-worker count
# (Config.workers → num_search_workers, solver.py:211), NOT web workers. It is
# read from SOLVER_WORKERS so the box's 2 shared vCPUs aren't pegged at the
# upstream default of 8. The CP-SAT solve runs in a background daemon thread
# (server.py:624) and releases the GIL, so it does not block the event loop;
# capping workers just limits CPU contention during the (rare, off-peak) solve.
Environment=SOLVER_WORKERS=2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Secrets + config (admin bootstrap, solver workers). NOT in git. Created during
# provisioning at /etc/boatsched/env (see deploy/README.md). Required: if this
# file is missing the service fails to start, which is the desired loud signal.
EnvironmentFile=/etc/boatsched/env

# The SQLite DB lives on a stable absolute path on local NVMe so its WAL/SHM
# sidecar files (boatsched.db-wal / -shm) sit on the same fast local disk and
# are not subject to ProtectSystem (ReadWritePaths re-opens this dir for writes).
ExecStart=/opt/boatsched/.venv/bin/boatsched-server \
    --db /var/lib/boatsched/boatsched.db \
    --host 127.0.0.1 --port 8000 \
    --workers ${SOLVER_WORKERS}

Restart=on-failure
RestartSec=5

# --- sandboxing -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/boatsched
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# OR-Tools' native libs may map executable memory; do NOT enable
# MemoryDenyWriteExecute (it can break the solver).

[Install]
WantedBy=multi-user.target
