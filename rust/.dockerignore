# Keep the build context small and reproducible.
#
# target/ — local build artifacts (rebuilt in-image).
# vendor/ — the gitignored OR-Tools SDK. CRITICAL: excluding it ensures the
#           image uses ONLY the ubuntu-24.04 SDK fetched in the Dockerfile, not
#           a host-local Arch build that would have the wrong ABI.
target/
vendor/

# Never ship databases into the image.
*.db
*.db-shm
*.db-wal

# VCS / editor noise.
.git/
.gitignore
**/*.swp
